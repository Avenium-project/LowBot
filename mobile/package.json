{
  "name": "open-dots-android",
  "private": true,
  "version": "2.0.0",
  "description": "Open Dots Android client (Capacitor shell around the static web UI). LowBot extension.",
  "scripts": {
    "build:ui": "npm --prefix ../client ci && npm --prefix ../client run build:export",
    "sync": "cap sync android",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "apk:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "capacitor-secure-storage-plugin": "^0.11.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
