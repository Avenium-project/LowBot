<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only; system CAs only. Self-hosted servers need a valid TLS
     certificate (e.g. Caddy + Let's Encrypt, or Tailscale HTTPS). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
