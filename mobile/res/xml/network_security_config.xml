<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system CAs only. Your LowBot server needs a valid certificate
     (Caddy + Let's Encrypt, or Tailscale HTTPS). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
